$设置工作目录 NebulaData$
__终端词库路径__:private/system/terminal.n
__日志目录__:database/log

Main #{
    // 启动服务器
    服务器:$创建服务器 :8080$
    $服务器.设置路由词库 private/system/router.n$

    // 检查服务器是否启动成功
    如果:$服务器.启动$==true
        _:$服务器.设置核心服务器$
        webui:$核心服务器$
    否则
        // 返回执行失败终止后续执行
        启动失败
        >终止
    如果尾

    // 启动成功进行计数
    启动次数:[$读 system 启动次数 0$+1]
    $写 system 启动次数 %启动次数%$

    // 首次初始化管理面板密码时，打印初始登录密码
    如果:%?__管理面板初始密码__%!=
        管理面板初始登录密码：%?__管理面板初始密码__%\r
    如果尾

    ─╔═══╗───╔╗─╔═╗╔═╗─╔═══╗───╔╗\r
    ─║╔═╗║───║║─╚╗╚╝╔╝─║╔═╗║───║║\r
    ─║║─╚╝───║║──╚╗╔╝──║╚═╝║───║║\r
    ─║║─╔╗─╔╗║║──╔╝╚╗──║╔══╝─╔╗║║\r
    ─║╚═╝║─║╚╝║─╔╝╔╗╚╗─║║────║╚╝║\r
    ─╚═══╝─╚══╝─╚═╝╚═╝─╚╝────╚══╝\r
    v %版本%\r
    start %启动次数%\r
    WebUI：%webui%
}#