				"-o",
				"dist/linux_arm64",
				"-tags",
				"linux",
				"./nebulaApp/main_linux.go"
			],
			"problemMatcher": [
				"$go"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "生成 arm Linux 可执行文件",
			"options": {
				"env": {
