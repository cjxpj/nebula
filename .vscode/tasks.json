{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "go",
            "label": "buildWindows_amd64",
            "command": "build",
            "args": [
                "-trimpath",
                "-ldflags",
                "-s -w",
                "-o",
                "dist/nebula.exe",
                "./nebulaApp/win"
            ],
            "problemMatcher": [
                "$go"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "生成 x64 位 Windows 可执行文件",
            "options": {
                "env": {
                    "GO111MODULE": "on",
                    "GOARCH": "amd64",
                    "GOOS": "windows",
                    "CGO_ENABLED": "0"
                }
            }
        },
        {
            "type": "go",
            "label": "buildLinux_amd64",
            "command": "build",
            "args": [
                "-trimpath",
                "-ldflags",
                "-s -w",
                "-o",
                "dist/nebula",
                "./nebulaApp/main_linux.go"
            ],
            "problemMatcher": [
                "$go"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "生成 x64 位 Linux 可执行文件",
            "options": {
                "env": {
                    "GO111MODULE": "on",
                    "GOARCH": "amd64",
                    "GOOS": "linux",
                    "CGO_ENABLED": "0"
                }
            }
        },
        {
            "type": "go",
            "label": "Android arm64",
            "command": "build",
            "args": [
                "-tags",
                "so",
                "-buildmode=c-shared",
                "-o",
                "dist/libnebula_arm64.so",
                "./nebulaApp"
            ],
            "problemMatcher": [
                "$go"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "生成 arm64 位 Android 可执行文件",
            "options": {
                "env": {
                    "GOOS": "android",
                    "GOARCH": "arm64",
                    "CGO_ENABLED": "1",
                    "CC": "D:\\android-ndk-r29\\android-ndk-r29\\toolchains\\llvm\\prebuilt\\windows-x86_64\\bin\\aarch64-linux-android29-clang.cmd"
                }
            }
        },
        {
            "type": "shell",
            "label": "打包 APK",
            "command": "gomobile",
            "args": [
                "build",
                "-target=android/arm64",
                "-o",
                "dist/nebula.apk",
                "-androidapi=30",
                "github.com/cjxpj/juiceAndroid"
            ],
            "problemMatcher": [],
            "detail": "打包 APK",
            "group": "build",
            "options": {
                "env": {
                    "ANDROID_NDK_HOME": "D:\\android-ndk-r29\\android-ndk-r29"
                }
            }
        },
        {
            "type": "shell",
            "label": "upx",
            "command": "upx",
            "args": [
                "--best",
                "--lzma",
                "dist/nebula.exe",
                "dist/nebula"
            ],
            "problemMatcher": [],
            "detail": "UPX"
        },
        {
            "label": "全部编译",
            "dependsOrder": "sequence",
            "dependsOn": [
                "buildWindows_amd64",
                "buildLinux_amd64",
                "upx"
            ],
            "problemMatcher": []
        }
    ]
}