					"GOARCH": "arm"
				}
			}
		},
		{
			"type": "go",
			"label": "buildLinux_amd386",
			"command": "build",
			"args": [
				"-ldflags",
				"-s -w",
				"-o",
				"dist/linux_amd386",
				"-tags",
				"linux",
				"./nebulaApp/main_linux.go"
			],
			"problemMatcher": [
				"$go"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "生成 x86 位 Linux 可执行文件",
			"options": {
				"env": {
					"GO111MODULE": "on",
