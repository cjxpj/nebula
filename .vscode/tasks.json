			"args": [
				"-ldflags",
				"-s -w",
				"-o",
				"dist/linux_amd64",
				"-tags",
				"linux",
				"./nebulaApp/main_linux.go"
			],
			"problemMatcher": [
				"$go"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "生成 x64 位 Linux 可执行文件",
			"options": {
				"env": {
