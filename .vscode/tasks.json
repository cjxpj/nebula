			"command": "build",
			"args": [
				"-ldflags",
				"-s -w",
				"-o",
				"dist/mac_amd64",
				"-tags",
				"darwin",
				"./nebulaApp/win"
			],
			"problemMatcher": [
				"$go"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "生成 macOS 可执行文件",
			"options": {
