{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "go",
            "label": "buildWindows_amd64",
            "command": "build",
            "args": [
                "-trimpath",
                "-ldflags",
                "-s -w",
                "-o",
                "dist/nebula.exe",
                "./nebulaApp/win"
            ],
            "problemMatcher": [
                "$go"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "生成 x64 位 Windows 可执行文件",
            "options": {
                "env": {
                    "GO111MODULE": "on",
                    "GOARCH": "amd64",
                    "GOOS": "windows",
                    "CGO_ENABLED": "0"
                }
            }
        },
        {
            "type": "go",
            "label": "buildLinux_amd64",
            "command": "build",
            "args": [
                "-trimpath",
                "-ldflags",
                "-s -w",
                "-o",
                "dist/nebula",
                "./nebulaApp/main_linux.go"
            ],
            "problemMatcher": [
                "$go"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "生成 x64 位 Linux 可执行文件",
            "options": {
                "env": {
                    "GO111MODULE": "on",
                    "GOARCH": "amd64",
                    "GOOS": "linux",
                    "CGO_ENABLED": "0"
                }
            }
        },
        {
            "type": "go",
            "label": "Android arm64 (.so)",
            "command": "build",
            "args": [
                "-tags",
                "so",
                "-buildmode=c-shared",
                "-o",
                "dist/libnebula_arm64.so",
                "./nebulaApp"
            ],
            "problemMatcher": [
                "$go"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译 arm64 Android .so 文件",
            "options": {
                "env": {
                    "GOOS": "android",
                    "GOARCH": "arm64",
                    "CGO_ENABLED": "1",
                    "CC": "E:\\android-ndk-r29\\android-ndk-r29\\toolchains\\llvm\\prebuilt\\windows-x86_64\\bin\\aarch64-linux-android29-clang.cmd"
                }
            }
        },
        {
            "type": "shell",
            "label": "复制 .so 到 jniLibs",
            "command": "xcopy",
            "args": [
                "/Y",
                "dist\\libnebula_arm64.so",
                "android\\app\\src\\main\\jniLibs\\arm64-v8a\\"
            ],
            "problemMatcher": [],
            "detail": "拷贝 .so 到 jniLibs"
        },
        {
            "type": "shell",
            "label": "Gradle 打包 APK",
            "command": ".\\gradlew.bat",
            "args": [
                "assembleDebug"
            ],
            "problemMatcher": [],
            "detail": "Gradle 编译 Android APK (debug 签名)",
            "options": {
                "cwd": "${workspaceFolder}\\android",
                "env": {
                    "JAVA_HOME": "C:\\Program Files\\Java\\jdk-17",
                    "ANDROID_SDK_ROOT": "E:\\android-sdk"
                }
            }
        },
        {
            "type": "shell",
            "label": "复制 APK 到 dist",
            "command": "xcopy",
            "args": [
                "/Y",
                "android\\app\\build\\outputs\\apk\\debug\\app-debug.apk",
                "dist\\nebula.apk*"
            ],
            "problemMatcher": [],
            "detail": "复制 APK 到 dist 并重命名为 nebula.apk"
        },
        {
            "label": "一键打包 APK",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Android arm64 (.so)",
                "复制 .so 到 jniLibs",
                "Gradle 打包 APK",
                "复制 APK 到 dist"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "一键打包：编译 .so → 拷贝 jniLibs → Gradle → dist/nebula.apk"
        },
        {
            "type": "shell",
            "label": "upx 压缩",
            "command": "upx",
            "args": [
                "--best",
                "--lzma",
                "dist/nebula.exe",
                "dist/nebula"
            ],
            "problemMatcher": [],
            "detail": "UPX 压缩"
        },
        {
            "label": "全部编译 (桌面端)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "buildWindows_amd64",
                "buildLinux_amd64",
                "upx 压缩"
            ],
            "problemMatcher": []
        }
    ]
}
