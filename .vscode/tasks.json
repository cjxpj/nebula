					"GOOS": "linux"
				}
			}
		},
		{
			"type": "go",
			"label": "buildLinux_arm386",
			"command": "build",
			"args": [
				"-ldflags",
				"-s -w",
				"-o",
				"dist/linux_arm386",
				"-tags",
				"linux",
				"./nebulaApp/main_linux.go"
			],
			"problemMatcher": [
				"$go"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "生成 arm Linux 可执行文件",
			"options": {
