			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "生成 x64 位 Windows 可执行文件",
			"options": {
				"env": {
					"GO111MODULE": "on",
					"GOARCH": "amd64"
				}
			}
		},
		{
			"type": "go",
			"label": "buildWindows_arm64",
			"command": "build",
			"args": [
				"-ldflags",
				"-H=windows -s -w",
				"-o",
				"dist/win_arm64.exe",
				"-tags",
				"windows",
				"./nebulaApp/win"
			],
			"problemMatcher": [
				"$go"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "生成 arm Windows 可执行文件",
			"options": {
				"env": {
					"GO111MODULE": "on",
					"GOARCH": "arm64"
				}
			}
		},
		{
			"type": "go",
			"label": "buildWindows_arm386",
			"command": "build",
			"args": [
				"-ldflags",
				"-H=windows -s -w",
				"-o",
				"dist/win_arm386.exe",
				"-tags",
				"windows",
				"./nebulaApp/win"
			],
			"problemMatcher": [
				"$go"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "生成 arm Windows 可执行文件",
			"options": {
				"env": {
