{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "go",
            "label": "buildWindows_amd64",
            "command": "build",
            "args": [
                "-ldflags",
                "-H=windows -s -w",
                "-o",
                "dist/nebula.exe",
                "-tags",
                "windows",
                "./nebulaApp/win"
            ],
            "problemMatcher": [
                "$go"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "生成 x64 位 Windows 可执行文件",
            "options": {
                "env": {
                    "GO111MODULE": "on",
                    "GOARCH": "amd64"
                }
            }
        },
        {
            "type": "go",
            "label": "buildLinux_amd64",
            "command": "build",
            "args": [
                "-ldflags",
                "-s -w",
                "-o",
                "dist/nebula",
                "-tags",
                "linux",
                "./nebulaApp/main_linux.go"
            ],
            "problemMatcher": [
                "$go"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "生成 x64 位 Linux 可执行文件",
            "options": {
                "env": {
                    "GO111MODULE": "on",
                    "GOARCH": "amd64",
                    "GOOS": "linux"
                }
            }
        },
        {
            "type": "shell",
            "label": "upx",
            "command": "upx",
            "args": [
                "dist/nebula.exe",
                "dist/nebula"
            ],
            "problemMatcher": [],
            "detail": "压缩可执行文件"
        },
        {
            "label": "全部编译",
            "dependsOrder": "sequence",
            "dependsOn": [
                "buildWindows_amd64",
                "buildLinux_amd64",
                "upx"
            ],
            "problemMatcher": []
        }
    ]
}